{
  "llm": {
    "endpoint": "http://127.0.0.1:8080/v1",
    "models": [
      { 
        "name": "gpt-neox-20b-q4", 
        "provider": "llama.cpp", 
        "context": 4096, 
        "n_gpu_layers": 28,
        "gpu_memory_usage": "~8GB",
        "description": "GPT-NeoX-20B quantized for planning and script generation"
      },
      { 
        "name": "mistral-7b-instruct-q5", 
        "provider": "llama.cpp", 
        "context": 8192, 
        "n_gpu_layers": 35,
        "gpu_memory_usage": "~6GB", 
        "description": "Mistral-7B for script criticism and refinement"
      }
    ],
    "roles": {
      "planner": "gpt-neox-20b-q4",
      "script_critic": "mistral-7b-instruct-q5",
      "code_generator": "gpt-neox-20b-q4"
    },
    "streaming": true,
    "temperature": 0.7,
    "max_tokens": 2048,
    "gpu_constraints": {
      "vram_limit": "11GB",
      "fallback_to_cpu_kv": true,
      "partial_offload_threshold": 0.9
    }
  },
  "audio": {
    "asr": "whisper.cpp",
    "aligner": "mfa", 
    "tts_scratch": "piper",
    "sample_rate": 48000,
    "channels": 2,
    "loudness": { 
      "I": -23, 
      "LRA": 7, 
      "TP": -1.0 
    },
    "formats": ["wav", "flac"]
  },
  "render": {
    "fps": 30, 
    "width": 1920, 
    "height": 1080,
    "device": "OPTIX",
    "fallback_device": "CUDA", 
    "preview_samples": 8, 
    "final_samples": 128,
    "tile_size": 256,
    "memory_limit_gb": 8
  },
  "encoders": { 
    "video": "h264_nvenc", 
    "preset": "p7", 
    "rc": "vbr_hq", 
    "cq": 19, 
    "look_ahead": 1, 
    "spatial_aq": 1, 
    "temporal_aq": 1,
    "fallback": "libx264",
    "fallback_preset": "medium"
  },
  "color": { 
    "ocio_config": "config/ocio/config.ocio", 
    "display": "Rec.709", 
    "eotf": "BT.1886",
    "working_space": "ACEScg",
    "tags_required": ["bt709", "bt1886"]
  },
  "quality": {
    "ssim_threshold": 0.9,
    "motion_threshold": 0.3,
    "text_legibility_threshold": 0.8,
    "color_accuracy_threshold": 0.95,
    "auto_retry": true,
    "max_retries": 3
  },
  "workers": {
    "blender": {
      "executable": "blender",
      "headless": true,
      "max_instances": 2,
      "timeout": 300,
      "memory_limit_gb": 4
    },
    "manim": {
      "renderer": "opengl",
      "fallback_renderer": "cairo",
      "max_instances": 4,
      "timeout": 120,
      "quality": "medium_quality"
    },
    "taichi": {
      "arch": "gpu",
      "fallback_arch": "cpu",
      "max_instances": 2,
      "timeout": 180
    }
  },
  "pipeline": {
    "max_concurrent": 3,
    "retry_delay": 5,
    "cleanup_after_hours": 24,
    "cache_artifacts": true,
    "cache_size_gb": 50
  },
  "telemetry": {
    "prometheus_port": 9090,
    "otel_endpoint": "http://localhost:4317",
    "log_level": "INFO",
    "metrics_interval": 10,
    "tracing": {
      "enabled": true,
      "jaeger_endpoint": "http://localhost:14268/api/traces",
      "sample_rate": 0.1
    },
    "sentry": {
      "enabled": false,
      "dsn": "${SENTRY_DSN}",
      "environment": "development"
    }
  },
  "sandbox": {
    "enabled": true,
    "type": "firejail",
    "max_concurrent": 3,
    "timeout": 60,
    "memory_limit": "512M",
    "cpu_cores": 2,
    "network_isolation": true,
    "allowed_modules": [
      "numpy", "math", "random", "typing", "datetime",
      "manim", "taichi", "bpy", "pathlib", "os"
    ],
    "blocked_syscalls": ["execve", "fork", "clone", "socket", "connect"]
  },
  "observability": {
    "frame_analysis": {
      "enabled": true,
      "ssim_threshold": 0.85,
      "psnr_threshold": 30.0,
      "vmaf_threshold": 70.0,
      "text_legibility_threshold": 0.80
    },
    "system_monitoring": {
      "gpu_stats": true,
      "cpu_stats": true,
      "memory_stats": true,
      "process_stats": true,
      "interval_seconds": 2
    },
    "error_tracking": {
      "structured_errors": true,
      "auto_remediation": true,
      "breadcrumbs": true
    }
  }
}